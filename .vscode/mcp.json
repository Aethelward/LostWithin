{
    "inputs": [
        {
            "id": "unreal-mcp-token",
            "type": "promptString",
            "description": "Paste token from Saved/MCP/capability-token",
            "password": true
        }
    ],
    "servers": {
        "unreal-engine": {
            "type": "http",
            "url": "http://127.0.0.1:3000/mcp",
            "headers": {
                "X-MCP-Capability-Token": "${input:unreal-mcp-token}"
            }
        }
    }
}
